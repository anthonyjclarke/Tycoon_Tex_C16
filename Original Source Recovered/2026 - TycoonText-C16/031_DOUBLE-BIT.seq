; PUT "DOUBLE-BIT";;; DO THE BIT FOR TYCOON TITLE;; 7 DIFFERENT LETTERS = 14 CHARS;WIDTH;; SET UP CHARS;LDX #$6F;DBLOP;LDA $3EE8,XSTA DBLSVE,X;LDA DWIDTH,XSTA $3EE8,X;DEXBPL DBLOP;; SAVED CHARS & MOVE NEW ONES IN;RTS;;;;;DWIDTH;; 'T';.BYTE $00,$FF,$FF,$0F,$0F,$0F,$0F,$0F.BYTE $00,$FC,$FC,$C0,$C0,$C0,$C0,$C0;; 'Y';.BYTE $00,$FC,$FC,$FC,$3F,$0F,$0F,$0F.BYTE $00,$FC,$FC,$FC,$F0,$C0,$C0,$C0;; 'C';.BYTE $00,$3F,$FF,$F0,$F0,$F0,$FF,$3F.BYTE $00,$FC,$FC,$00,$00,$00,$FC,$FC;; 'O';.BYTE $00,$3F,$FF,$F0,$F0,$F0,$FF,$3F.BYTE $00,$F0,$FC,$3C,$3C,$3C,$FC,$F0;; 'N';.BYTE $00,$FC,$FC,$FF,$FF,$F3,$F0,$F0.BYTE $00,$3C,$3C,$3C,$FC,$FC,$FC,$FC;; 'E';.BYTE $00,$3F,$FF,$F0,$FF,$F0,$FF,$3F.BYTE $00,$F0,$FC,$00,$C0,$00,$FC,$F0;; 'X';.BYTE $00,$FC,$FC,$3F,$0F,$3F,$FC,$FC.BYTE $00,$FC,$FC,$F0,$C0,$F0,$FC,$FC;;;;.END