; PUT "HIGH-STUFF";;*****************************;; DO ALL THE HIGH SCORE STUFF;;*****************************;;;SIKBUF .BYTE '000000';; SIKBUF MUST BE FILLED WITH; THE SCORE FROM THE LAST GAME; BEFORE HIGH ROUTINE IS CALLED;HIGH;LDA #0STA HISPNTSTA POSITN;HLP1;LDA HISPNTCLCADC #6;TAX;SECLDY #6;HLP2;LDA HISTBL-1,XSBC SIKBUF-1,Y;DEXDEYBNE HLP2;BCC ITSIN ;* GOT IN !!!;LDA HISPNTCLCADC #14STA HISPNT;INC POSITN;LDA POSITNCMP #8BNE HLP1;; NOT IN THE TABLE - SUSSED;RTS;;********************************;ITSIN;; IN AT POSITN  (0-7);JSR MVESCR   ;* MOVE SCORES DOWNJSR PRHISC   ;* PRINT TABLE;RTS;;;********************************;HOFSET;.BYTE 0,14,28,42,56.BYTE 70,84,98;;SCROFT;.WORD $0E13.WORD $0E13+40.WORD $0E13+40+40.WORD $0E13+40+40+40.WORD $0E13+40+40+40+40.WORD $0E13+40+40+40+40+40.WORD $0E13+40+40+40+40+40+40.WORD $0E13+40+40+40+40+40+80;;MVESCR;LDX POSITN;LDA HOFSET,X;STA INCNT;CPX #7BEQ INLAST;LDX #98;MOVESC;LDA HISTBL,XSTA HISTBL+14,X;DEXCPX INCNT;BNE MOVESC;INLAST;LDX INCNT;LDY #0;MVT1;LDA SIKBUF,YSTA HISTBL,X;LDA #$30STA SIKBUF,Y;INXINY;CPY #6BNE MVT1;; SCORE IN;JSR PRHISC   ;* PRINT UPDATED TBL;LDA POSITNASL ATAX;LDA SCROFT,X;STA HISCRSTA COLL;LDA SCROFT+1,X;STA HISCR+1;SECSBC #4;STA COLL+1;;; HISCR,HISCR+1 POINT TO SCREEN; WHERE TO ENTER NAME;;LDY #6;LUMP;LDA #1STA STRIN,Y;DEYBPL LUMP;LDA INCNT;CLCADC #6;STA XBLOB   ;* OFFSET INTO TABLE;LDA #0STA LETTER  ;* NO OF LETTERS;JMP PRITIT;NOLOP;;JSR REDJOS;; JOYSTICK IS CONTINUALLY READ;LDA LETTERTAY;;BIT JFIRE   ;* FIRE = FINISHEDBPL NO;RTS         ;* FINISHED;NO;BIT JUP     ;* CHAR=CHAR+1BPL CHUP;LDX STRIN,Y;INXCPX #59BNE NOT9    ;* NOT Z YET;LDX #1BNE NOTZ;NOT9;CPX #27BNE NOTZ;LDX #32     ;* NOW TO ZERO;NOTZ;TXASTA STRIN,Y;;;****************************;CHUP;BIT JDOWN      ;* CHAR=CHAR-1BPL CHDOWN;LDX STRIN,Y;DEX;BNE NOTR;LDX #58BNE NOTA;NOTR;CPX #31BNE NOTA;LDX #26;NOTA;TXASTA STRIN,Y;;;****************************;CHDOWN;BIT JLEFT      ;* EDIT CHAR -1BPL CHLEFT;DEY;BPL NA3;LDY #0;NA3;STY LETTER;;;*********************;CHLEFT;BIT JRIGHTBPL PRITIT;INY;CPY #7BNE NA4;LDY #6;NA4;STY LETTER;;*********************;PRITIT;LDY #6;NA5;LDA STRIN,YSTA (HISCR),Y    ;* ONTO SCREEN;DEYBPL NA5;JSR FLALET    ;* FLASH LETTER;LDX XBLOB;LDY #0;NA6;LDA STRIN,YSTA HISTBL,X;INXINY;CPY #7;BNE NA6;;LDX #$30JSR DELAY+2;JMP NOLOP;FLALET;LDY #6;FLP1;CPY LETTERBNE NOFLP1;LDA #$71BNE NOFLP2;NOFLP1;LDA #$11;NOFLP2;STA (COLL),Y;DEYBPL FLP1;RTS;;;**********************;STRIN .BYTE '0123456';; TEMP FOR NAME INPUT;;;**********************;; ALL THE HISCORE CRAP;;**********************;BANNER;.BYTE 'THE TYCOONS!';BANNRE;.BYTE '  THE MENU  ';;PRHISC;; PRINT HI-SCORE TABLE;LDX #11;BANL;LDA BANNER,XAND #$3FSTA $D94,X;LDA BANNRE,XAND #$3FSTA $DA8,X;DEXBPL BANL;;BANS;LDA #$0ASTA HISCRSTA HISCLLDA #$0ESTA HISCR+1LDA #$0ASTA HISCL+1;;LDA #1STA NUMB    ;* NUMBER;LDX #0;HOOLOP      ;* MAIN LOOP;LDY #0STY MENATW;TRY2;LDA TEDAND #7BEQ TRY2;ORA #$50STA (HISCL),Y;PHA;LDA NUMBORA #$30    ;* DIGIT;STA (HISCR),YINY  ;PLASTA (HISCL),YSTA ALTEM;LDA #$2ESTA (HISCR),YINY;LDA #5STA TEMCNT;HOOW;LDA HISTBL,X;STA WALL;CMP #'0BNE FOO2;CPY #6BEQ FOO3;LDA MENATWBNE FOO3;LDA #32BNE FOO1;FOO2;LDA #1;STA MENATW;FOO3;LDA WALL;FOO1;STA (HISCR),Y;INY;INX;DEC TEMCNT;BPL HOOW;;LDA #$2DSTA (HISCR),YINY;;LDA #6STA TEMCNT;HOOQ;LDA HISTBL,XAND #$3FSTA (HISCR),Y;LDA ALTEMSTA (HISCL),Y;INY;INX;DEC TEMCNTBPL HOOQ;LDA HISCRCLCADC #40STA HISCRSTA HISCL;LDA HISCR+1ADC #0STA HISCR+1;SECSBC #4STA HISCL+1;;;INX      ;* DUMMY;INC NUMB;LDA NUMBCMP #9BEQ HRR;JMP HOOLOP;HRR;RTS;.END