; PUT "JOYSTIK";;*******************;; READ THE JOYSTICK;;*******************;JPORT = TED+8;;;REDJOS;LDA DEMOBEQ BLOTTO;JMP DEMOON;BLOTTO;LDA JOYSELBNE TRYJOS;JMP KEY;TRYJOS;LDA #$FD        ;* PORT 0STA JPORT;LDA #$4ASTA XTRCDE      ;* 'LSR A';LDA JPORTEOR #$FFBNE NAYE;; TRY PORT 1;LDA #$FA        ;* PORT 1STA JPORT;LDA #$EASTA XTRCDE      ;* 'NOP';LDA JPORTEOR #$FF;BNE NAYE        ;* READ SOME DATA;;NOMOVE;LDA #0LDX #4;NOM1;STA JLEFT,XDEXBPL NOM1;RTS;;NAYE;ROR AROR JUP;ROR AROR JDOWN;ROR AROR JLEFT;ROR AROR JRIGHT;LSR ALSR ALSR A;XTRCDE;NOP;ROR JFIRE;LDA #1STA JMOVE;RTS;;.END