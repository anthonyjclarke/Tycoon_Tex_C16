; PUT "ALIEN-CHRGET";; GET THE ALIEN DEFINITIONS; & COLOURS FOR EACH SHEET;ALIGET;LDY AREA     ;* SHEET TYPE;LDX TIM48,Y;LDY #0;FTCHTM;LDA ARRCHR,X ;* ARROWSTA $3EE8,Y;LDA BACHAR,X ;* BOUNCERSTA $3F68,Y;LDA SUCHAR,X ;* SUICIDESTA $3FA8,Y;INXINYCPY #$30BNE FTCHTM;;---------------------------;; NOW SET UP THE COLOURS;;LDY AREA;;LDX TIM5,Y;;LDA MARIDA,X;STA BALCOL;;LDA MARIDA+1,X;STA ARRCOL;;LDA MARIDA+2,X;STA BOMCOL;;LDA MARIDA+3,X;STA JETCOL;;LDA MARIDA+4,X;STA SUICOL;LDA #$78;STA BALCOLSTA ARRCOLSTA BOMCOLSTA JETCOLSTA SUICOL;RTS;;;-------------------------;MARIDA;; TABLE FOR COLOURS FOR ALIENS;; ORDER = 1. BOUNCING BALL;         2. ARROW;         3. BOMB;         4. JET;         5. SUICIDE THING;; DESERT;.BYTE $78,$7A,$7B,$7C,$7D;; ICE;.BYTE $78,$7A,$7B,$7C,$7D;; PIPE;.BYTE $79,$7A,$7B,$7C,$7D;;;;.END