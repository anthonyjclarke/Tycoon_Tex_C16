; PUT "LEVEL-OVER";; LEVEL COMPLETED SO TELL THE; GONK THAT AND DO SOME NICE; STUFF.;;LVLOVR;LDA DEADBNE LVLOVR;; WAIT FOR DYONG TO END;JSR SCRLND;; BRING ON NEW LAND;SEI;LDA #1STA STOP;LDA #0STA HILSPDSTA GNDSPDSTA JUMPINSTA FIRE;JSR ALLKIL  ;* KILL ALLL ALIENS;JSR MANOFF;LDA #<$EA9STA ML;LDA #>$EA9STA ML+1;LDA #0STA WAKSPDSTA NORIGTSTA DONE;JSR CLSDIS;JSR MANON;CLI;; MAN OVER AT LEFT OF SCREEN;LDY #20;CONL1;LDA #'*;STA $DC2,YSTA $DC2+160,Y;LDA CONSCR,YAND #$3FSTA $DC2+80,Y;LDA CONSCR+21,YAND #$3FSTA $DC2+240,Y;DEYBPL CONL1;LDA #'*STA $DEASTA $DEA+80STA $DEA+20STA $DEA+80+20;LDA LEVEL;PHA;AND #$F0LSR ALSR ALSR ALSR A;ORA #$30STA $EBA  ;* MSB;PLA;AND #$FORA #$30;STA $EBB  ;* LSB;; LEVEL ON SCREEN;LDA SOFLAGBEQ GONAD;; NO SOUND;LDA #%00100011 ;* CHAN #2STA VOL;LDA #3STA SOU2HI;GONAD;LDA #1JSR SCORE;LDA #1JSR PRESDO;LDA PRESHIASL AASL AASL A;ORA PRESLO;STA SOU2LO;LDX #$08JSR DELAY+2;LDA BLOOUTBEQ GONAD;LDA #0STA VOL;; BONUS SCORE = OIL PRESSURE;LDA #6STA ROLL;CONL2;LDX #$00JSR DELAY+2;DEC ROLLBNE CONL2;;---------------------;JSR NEWLVL;; SET UP ALL THE VARIABLES FOR; THE NEXT LEVEL;JSR CLSDIS;LDA #0STA STOP;;;;RTS;;;;CONSCR;.BYTE '* CONGRATULATIONS ! *'.BYTE ' LEVEL: 00 COMPLETED ';;;;;.END