 0 ;* LAST HILL #;LEVEL    .BYTE 0 ;* LEVEL #LEVCNT   .BYTE 0 ;* LEVEL COUNT;MAXCRA   .BYTE 0 ;* CRATER SIZENOMAN    .BYTE 0 ;* COUNT;STAR1    .BYTE 0 ;* STAR COUNTSTARCT   .BYTE 0 ;* STAR COUNT;BASDLY   .BYTE 0 ;* TIME DELAY;;;*=$033C;;MESCOL   .BYTE 0 ;* MESSAGE COL.;INTYPE   .BYTE 0 ;* IRQ NUMBER;HILSPD   .BYTE 1 ;* HILL SPEEDGNDSPD   .BYTE 4 ;* GROUND SPEED;MVETEM   .BYTE 0 ;* MOVE TEMPOBLOOUT   .BYTE 0 ;* OIL PRES=0WAKSPD   .BYTE 0 ;* WALK SPEED;RCNT     .BYTE 0 ;* MOVE CNT;NOLEFT   .BYTE 0 ;* STOP LEFTNORIGT   .BYTE 0 ;* STOP RIGHT;SCRCNT   .BYTE 0 ;* SCROLL CNT;HILLCL   .BYTE 0 ;* HILL BKGND COLROADCL   .BYTE 0 ;* ROAD BKGND COL;JTEMP    .BYTE 0 ;* JUMP TEMPOFIRTEM   .BYTE 0 ;* FIRE TEMPOANITEM   .BYTE 0 ;* ANIMATE TEMPO;DEATH    .BYTE 0 ;* DEATH FLAGDEAD     .BYTE 0 ;* DEAD FLAG;TDEAD    .BYTE 0 ;* TEMPODCOUNT   .BYTE 0 ;* DEATH COUNTFINITO   .BYTE 0 ;* ALL OVER FLAG;STOP     .BYTE 0 ;* STOP FLAGLIVES    .BYTE 0 ;* NO. OF LIVES;HISPNT   .BYTE 0 ;* HI-SCOREPOSITN   .BYTE 0 ;* POSITIONLETTER   .BYTE 0 ;* LETTERINCNT    .BYTE 0 ;* OFFSET IN TBLNUMB     .BYTE 0 ;* ??;XBLOB    .BYTE 0 ;* SOD OFF.!ALTEM    .BYTE 0 ;* SOD OFF.!MENATW   .BYTE 0 ;* SOD OFF.!TEMCNT   .BYTE 0 ;* SOD OFF.!WALL     .BYTE 0 ;* SOD OFF.!STOPAN   .BYTE 0 ;* HALT ANI.DEMO     .BYTE 0 ;* SOD OFF.!EXIT     .BYTE 0 ;* SOD OFF.!NICET    .BYTE 0 ;* TEMPO;FCOL2    .BYTE 0 ;* TIT COLOURFLST1    .BYTE 0 ;* FLASH TEMPOFLST2    .BYTE 0 ;* FLASH TEMPO;TPCNT    .BYTE 0 ;* PIPE COUNTRTEM     .BYTE 0 ;* TEMP;PLA1     .BYTE 0 ;* COLOURPLA2     .BYTE 0 ;* COLOURPLACOL   .BYTE 0 ;* COLOUR;HIL1     .BYTE 0 ;* COLOURHIL2     .BYTE 0 ;* COLOURHIL3     .BYTE 0 ;* COLOUR;COL1     .BYTE 0 ;* COLOURCOL2     .BYTE 0 ;* COLOURCOL3     .BYTE 0 ;* COLOUR;DONE     .BYTE 0 ;* SECTION DONE;ARRON    .BYTE 0 ;* ARROW ON ?ARROFF   .BYTE 0 ;* ARROW OFF ?ARRTEM   .BYTE 0 ;* ARROW TEMPOARRPRN   .BYTE 0 ;* PRINT ARROW?;JETON    .BYTE 0