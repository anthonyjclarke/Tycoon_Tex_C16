; PUT "ROAD/BUILDER";; THIS BUILDS UP THE NEXT SEXTION; OF ROAD.THE TYPE OF GROUND IS; DEPENDANT ON THE VARIABLE AREA;; AREA = 0   -   DESERT;;      = 1   -   ICE;;      = 2   -   ALL PIPES;;ROAD;LDA ONLYRD   ;* ONLY ROAD ?BNE DOROD    ;* YES;LDA RNDBPL DOROD;DEC RDTMBNE DOROD;LDA #18STA RDTM;JMP BREAK;DOROD;LDA AREABNE NTDES;; NEW PIECE OF DESERT;JSR RADYAND #3;STA RTEM;CMP #3BNE NTDSPP;; IF = 3 MEANS DO COUNT FOR; POSSIBILITY OF NEXT PIECE; BEING AN ODD PIECE OF PIPE.;INC TPCNTLDA TPCNT;CMP #9;; YES DO SOME PIPE;BEQ NTICE;; WE'LL HAVE TO DO SOME MORE; DESERT THEN.;LDA TEDAND #1STA RTEM;NTDSPP;LDA RTEM;ASL A;TAX;LDA DESCHR,XSTA PLONK;; START CHAR;LDA DESCHR+1,XSTA BUFLEN;; LENGTH OF CHAR;JMP PUTBUF;;******************;NTDES;; NOT DESERT SO TRY ICE;CMP #1BNE NTICE;; NEW PIECE OF ICE;JSR RADYAND #3;STA RTEM;CMP #3BNE NTICPP;; IF = 3 MEANS DO COUNT FOR; POSSIBILITY OF NEXT PIECE; BEING AN ODD PIECE OF PIPE.;INC TPCNTLDA TPCNT;CMP #9;; YES DO A PIPE;BEQ NTICE;LDA TED+1AND #1STA RTEM;NTICPP;LDA RTEM;ASL A;TAX;LDA ICECHR,XSTA PLONK;; START CHAR;LDA ICECHR+1,XSTA BUFLEN;; LENGTH;JMP PUTBUF;;****************;NTICE;; A JUMP IS MADE TO HERE IF IT; HAS BEEN DECIDED THAT AN ODD; PIECE OF PIPE IS NEEDED;LDA #0STA TPCNT;; ZERO THE TAP FREQUENCY COUNT;; WE MUST BE IN THE ALL PIPE BIT.;JSR RADYAND #3;BEQ STPIP;TAXDEX;INC COUNTR,XLDA COUNTR,X;CMP CNTCMP,XBNE FYP;LDA #0STA COUNTR,X;INXTXA;BNE STPIP;FYP;LDA #0;; COUNT NO FINISHED SO JUST; DO THE ORDINAIRY PIECE OF PIPE.;STPIP;ASL A;TAX;LDA PIPCHR,XSTA PLONK;; START CHAR;LDA PIPCHR+1,XSTA BUFLEN;; LENGTH OF CHAR;PUTBUF;; SHOVE CHARS INTO SCRBUF;LDX #0;FILBUF;LDA PLONKSTA SCRBUF,X;INC PLONK;INXCPX BUFLENBNE FILBUF;LDA #0STA BUFPOI;RTS;;;;;**********************;DESCHR;.BYTE 234,4.BYTE 238,4.BYTE 242,2;;**********************;ICECHR;.BYTE 244,4.BYTE 248,4.BYTE 252,4;;**********************;PIPCHR;.BYTE 200,4.BYTE 210,4.BYTE 204,4.BYTE 208,2;;***********;COUNTR .BYTE 1,4,7;CNTCMP .BYTE 9,14,12;;***********;;SCRBUF;*=*+24;;;;***********;RADY;LDA TEDAND #3TAX;LDA RND,X;RTS;;.END