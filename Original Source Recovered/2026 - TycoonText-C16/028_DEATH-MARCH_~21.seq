; PUT "DEATH-MARCH !";;;  ALL THE DEAD NICE STUFF -;  ALTHOUGH I DON'T KNOW WHATS;  NICE ABOUT DYING ?.;;UPDEAD;LDA TITLEBEQ YOMAZ;RTS;YOMAZ;;; LDA CHEAT; BEQ NCHEAT;; RTS;; NCHEAT;LDA DEADBNE UPSOK;; NOT ACTUALLY DEAD, WALLY.;RTS;UPSOK;LDA FINITOBEQ DOGGY;JMP ALLOVR;; IF IT DOES THAT JUMP IT MEANS; THE BASIC LOOP HAS NOT REALISED; THAT YOU HAVE ENDED THE GAME.;DOGGY;LDA DEATHBNE DOINGT;; WE ARE HERE FOR THE FIRST TIME;LDA ALSTATSTA STATEM;LDA #0STA ALSTAT ;* NO ALIENS PLEASE;LDA #1STA DEATHSTA STOPAN ;* STOP ANIMATIONSSTA TDEAD  ;* DEATH TEMPO COUNT;LDA #24STA DCOUNT;JSR MANOFF;LDX #0;D1;LDA $3E00,XSTA SAVECH,X;INXCPX #$A8BNE D1;; COPY VERTICAL CHARS OUT;LDA #<FALLYSTA MANL+1STA MANO+1;LDA #>FALLYSTA MANL+2STA MANO+2;LDA #1STA STOP;; STOP ALL MOVEMENT,ANIMATION ETC;JSR ROTATE;; TELL THE PRINT-MAN THAT HE HAS; NOW FALLEN DOWN (DEAD) SO PRINT; HIM HORIZONTALLY.;JSR ALLKIL ;* KILL ALL ALIENS;JSR CLSDIS;JSR MANON;DOINGT;JSR MANON;DEC TDEADBEQ DODT;RTS;DODT;LDA #2STA TDEAD;DEC DCOUNTBEQ DEADRI  ;* FINISHED ALL DYING;; HERE IT WILL DO THE SLOWING; DOWN OF ALL THE SCROLLING AND; THE SCROLLING OF THE MAN INTO; THE GROUND.;;JSR SINK;; SINK INTO EARTH BIT !;RTS;DEADRI;; ALL THE DYING HAS BEEN FINISHED;JSR MANOFF;LDX #0;GTBK;LDA SAVECH,XSTA $3E00,X;INXCPX #$A8BNE GTBK;; GET CHARS BACK;LDA #<YVALSTA MANL+1STA MANO+1;LDA #>YVALSTA MANL+2STA MANO+2;LDA #0STA STOPANSTA DEADSTA DEATHSTA DISJUM;DEC $0C65       ;* SCREEN;DEC LIVESBEQ ALLOVR;; WAS THAT HIS LAST LIFE ?;LDA #<$EA9STA ML;LDA #>$EA9STA ML+1;LDA #0STA WAKSPDSTA NORIGTSTA FINITOSTA STOP;LDA #1STA NOLEFT;JSR SCRLND ;* NEW LAND ON;LDA #0STA DEMOD  ;* DEMO COUNT;LDA STATEMSTA ALSTAT;RTS;;******************************;ALLOVR;; ALL LIVES GONE - SORRY BUSTER !;LDA #1STA FINITOSTA STOP;RTS;;;******************************;.END