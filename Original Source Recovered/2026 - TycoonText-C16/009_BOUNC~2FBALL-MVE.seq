; PUT "BOUNC/BALL-MVE";; DO ALL THE MOVING OF THE BALL;MBALL;; WE'RE ALLOWD A BOUNCING BALL;LDA BALLONBNE UPBALL ;* ALREADY ON;; SHALL WE START A NEW ONE ?;LDA RND+2;CMP BSKILLBCC FREGGY;DEC BALTEMBEQ STBAL;FREGGY;RTS;STBAL;; START ONE;LDA RND+2AND #3STA BALTEM;LDA RND+1AND #3CLCADC BALTEM     ;* ACC = 0 TO 6;PHA;CLCADC #2;STA BALCNT     ;* START POS;PLA;ASL ATAX;LDA BALLST,X   ;*STA PBAL       ;*;              ;* RANDOM STARTINGLDA BALLST+1,X ;* POSITIONSTA PBAL+1     ;*;LDX #1STX BALMVE     ;* MOVING DOWNSTX PRBALL     ;* PRINT BALLOONSTX BALLON     ;* ITS NOW ON LADS;DEXSTX RUBBAL     ;* DON'T RUB ITSTX BALLX      ;* X COUNT;RTS;;***********;UPBALL;LDA #0STA PRBALL   ;* DONT PRINT IT;LDA PBAL     ;*STA RBAL     ;* TELL IT WHERE TO;            ;*LDA PBAL+1   ;* RUB OUTSTA RBAL+1   ;*;INC BALLX;LDA BALLX    ;* X COUNTCMP #$26BEQ KILBAL;LDA BALMVE   ;* MOVING UP/DOWNBEQ BNGUP    ;* GOING UP;LDA PBALCLCADC #39STA PBAL;LDA PBAL+1ADC #0STA PBAL+1;INC BALCNTLDA BALCNTCMP #9BNE NBLBT   ;* NOT HIT BOTTOM;LDA BALMVEEOR #1STA BALMVE  ;* MOVE UP NEXT TIME;NBLBT;LDA #1STA PRBALL  ;* PRINT NEW POS;STA RUBBAL  ;* RUB OLD POS;RTS;BNGUP;; MUST BE GOING UP;LDA PBALSECSBC #41STA PBAL;LDA PBAL+1SBC #0STA PBAL+1;DEC BALCNTBNE NBTPBT;LDA BALMVEEOR #1     ;* REVERSE DIRECTIONSTA BALMVE;NBTPBT;; NOT REACHED TOP;LDA #1STA PRBALL;          ;* PRINT & RUB BALLSTA RUBBAL;;RTS;;**************;KILBAL;; GET RID OF BALL;LDA RND+1AND #$3FCLCADC BALLFRSTA BALTEM;LDX #0STX BALLON;INXSTX RUBBAL ;* RUB IT OUT;RTS;;****************;BALLST ;* START POSITIONS;;.WORD $EF5-240.WORD $EF5-200,$EF5-160,$EF5-120.WORD $EF5-80,$EF5-40,$EF5;;****************;;;;;.END