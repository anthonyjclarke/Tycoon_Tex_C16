; PUT "EXPLOSIONS";; CALLED WHEN AN ALIEN HAS; BEEN HIT BY THE TEXANS BULLET;; ** NOTE **;;  THERE WILL ONLY EVER BE ONE;  EXPLOSION ON THE SCREEN AT;  ANY ONE TIME (1 BULLET - 1;  EXPLOSION - OK.!);INEXPL;; START IT OFF;; X,Y ARE ENTERED WITH THE LO,HI; ADDRESS OF THE TL CORNER OF THE; BLOB;;TXA;SECSBC #80STA PEXPLSTA CEXPL;TYA;SBC #0;STA PEXPL+1;SECSBC #4;STA CEXPL+1  ;* COLOUR LO;LDX #1STX EXPLON   ;* ONE'S NOW ONSTX PREX     ;* PRINT ITSTX EXTEM    ;* START TEMPO;DEXSTX EXCNT    ;* COUNT;RTS;;-----------------------------;UPEXPL;LDA PAUSE ;* PAUSE ONBNE SHUKS;LDA EXPLONBNE THESON;RTS;THESON;DEC EXTEMBEQ LATE;SHUKS;RTS;LATE;LDA #2STA EXTEM;INC EXCNTLDA EXCNTCMP #9BEQ KILEX;RTS;KILEX;LDX #0STX PREXSTX EXPLON ;* NOT ON ANY MORE;RTS;;-----------------------------;PRINTX;;LDA PREXBNE DEXPRT;RTS;DEXPRT;; PRINT EXPLOSION DEPENDING; ON THE EXCNT VALUE;;;     434;    43234;    32123;    43234;     434;;;  FORMAT OF EXPLOSION;LDA #123;LDX EXCNTCPX #5BCC PRNTEX;LDA #32;PRNTEX;STA CHRON;; SET TO SPACE OR CHAR;DEXTXA;TAY;ASL A;TAX;LDA COLTBL,YSTA EXCOL;LDA EXSTAT,XSTA EXBITS    ;* NO OF BLOCKS;LDA EXSTAT+1,X;;  OFFSET INTO Y;TAX;EXPL1;LDY EXYTBL,XLDA CHRONSTA (PEXPL),Y;LDA EXCOLSTA (CEXPL),Y;INXDEC EXBITSBPL EXPL1;RTS;COLTBL;.BYTE $71,$22,$77,$52.BYTE $71,$71,$71,$71;EXYTBL;.BYTE 82.BYTE 42,81,83,122.BYTE 2,41,43,80,84,121,123,162.BYTE 1,3,40,44,120,124,161,163;EXSTAT;; NO OF BLOCK,POINTER INTO ^;.BYTE 0,0    ;.BYTE 3,1    ; ALL TO BE.BYTE 7,5    ; PRINTED.BYTE 7,13   ;;.BYTE 7,13   ;.BYTE 7,5    ; TO BE RUBBED OUT.BYTE 3,1    ;.BYTE 0,0    ;;;;;;.END