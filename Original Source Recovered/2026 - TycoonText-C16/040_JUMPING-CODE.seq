; PUT "JUMPING-CODE";;;;;JUMPER;; MAIN ENTRY POINT WHENEVER UP; IS PRESSED.;LDA DISJUM ;* NOT ALLOWD ?BNE JEX    ;* NO !;LDA JUMPIN ;* ALREADY LEAPINGBNE JEX    ;* LEAVE US !;LDA #1STA JUMPINSTA JTEMP;LDA #10STA JUMPY  ;* Y COUNT;JEX;RTS;;*******************************;UPJUMP;; UPDATE JUMP;LDA JUMPIN  ;* IS HE ACTUALLYBEQ JEX     ;* JUMPING ??????;DEC JTEMP  ;* TEMPOBNE JEX;LDA #2STA JTEMP;DEC JUMPYBMI ONGRND  ;* BACK ON GROUND;JSR MANOFF;LDA JUMPYCMP #5BCS GOINUP  ;* STILL GOING UP;; MUST BE ON HIS WAY DOWN !!;LDA MLCLCADC #40STA ML;LDA ML+1ADC #0STA ML+1;BPL JRUX;GOINUP;LDA MLSECSBC #40STA ML;LDA ML+1SBC #0STA ML+1;JRUX;JSR MANON;RTS;;*************;;ONGRND;; BACK ON GROUND AGAIN !;LDA #0STA JUMPIN;RTS;;;;;;;;.END