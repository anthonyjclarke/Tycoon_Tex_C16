; PUT "MAGNIFICENT";;; CO-ORDINATE THE TITLE STUFF.;;GLOPPY;SEI;LDA #1STA STOPSTA TITLE;JSR SETSHT;JSR SETUP;LDX #$70STX PLACOL ;* BOTH PLAY AREA ANDSTX ROADCL ;* ROAD BAKGRND COL=$70;INXSTX MANCOL ;* MAN WHITESTX MESCOL ;* MESSAGE COL;JSR CLSDIS;LDA #$32STA PLA1;LDA #$62STA PLA2;; TELL ALL IRQ STUFF WE ARE IN THE; TITLE STUFF AND NOT IN THE GAME;LDA #<$0EBBSTA ML;LDA #>$0EBBSTA ML+1;JSR MANON;; PRINT THE MAN IN THE CENTRE; OF THE SCREEN;LDA #$03STA GNDSPD;LDA #$07STA ANISPD;LDX #2STX NICETSTX FLST1STX FLST2;DEXSTX HILSPDSTX ANITEMSTX WAKSPD;; SET THE SPEEDS OF THE HILLS; AND GROUND & ANIMATION;STX ONLYRD;; ONLY HAVE ROAD (NO POT-HOLES);DEXSTX EXITSTX FIRESTX DEMOSTX COUNTL   ;* COUNTER FO DEMO;JSR SCREEN;JSR PRBANN;JSR PRMENU;JSR SETIRQ;CLI;JSR HIGH;; DID WE HAVE A HIGH SCORE ?;TITLOP;INC COUNTLBEQ STDEMO;LDX #$40JSR DELAY+2;JSR PRHISC  ;* PRINT HI-SCORES;JSR FUNKIT  ;* DO SELECTION STUFF;LDA EXITBEQ TITLOP;; RETURNS WILL EXIT=1 IF READY; TO PLAY;DOGBRT;LDX #$6F;BREST;LDA DBLSVE,XSTA $3EE8,X;DEXBPL BREST;; GET CHARS BACK;JMP PLGAME;STDEMO;LDA #1STA DEMO;BNE DOGBRT;;;;;;.END