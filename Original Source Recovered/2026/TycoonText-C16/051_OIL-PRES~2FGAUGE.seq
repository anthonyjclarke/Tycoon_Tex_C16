; PUT "OIL-PRES/GAUGE";; ALL THE ROUTINES ASSOCIATED; WITH THE OIL PRESSURE GAUGE.;PROILP;; PRINT THE OIL PRESSURE GAUGE; LENGTH DEPENDANT ON:-;; PRESLO 0-7; PRESHI 0-26;; START OF GAUGE = $0C0D;; CHARS USED :-;; 79 = FULL CHAR; 80 = MOVING TOP BITS; 81 = CLEAR SECTION;LDA PRESLOASL AASL AASL A;TAXLDY #0;PRES1;LDA PRESCH,XSTA $3E80,Y;INXINYCPY #8BNE PRES1;; END BIT NOW PROGRAMMED;LDY #0LDA #79;PRES2;CPY PRESHI    ;* END YET ?BPL CHAR1;JPBAK;STA $0C0D,Y;INYCPY #26BNE PRES2;RTS;;CHAR1;CMP #80BEQ CHAR2;CMP #81BEQ JPBAK;LDA #80BNE JPBAK;CHAR2;LDA #81BNE JPBAK;;;**********;PRESDO;; MOVE OIL PRESSURE DOWN ONE PIXEL;; 'BLOOUT' IS SET IF PRESSURE IS 0;STA AMDO    ;* AMOUNT TO GO DOWN;LDA BLOOUTBNE KRIPT;LDA PRESLOSECSBC AMDO;STA PRESLO;BPL KRIPT;DEC PRESHIBPL NTZER;LDX #1STX BLOOUT;LDA #0BEQ SETZER;NTZER;LDA #7;SETZER;STA PRESLO;KRIPT;RTS;;**************;PRESCH;;.BYTE  $FF,000,000,000,000,000,000,$FF.BYTE  $FF,$00,$80,$80,$80,$80,$00,$FF.BYTE  $FF,$00,$C0,$C0,$C0,$C0,$00,$FF.BYTE  $FF,$00,$E0,$E0,$E0,$E0,$00,$FF.BYTE  $FF,$00,$F0,$F0,$F0,$F0,$00,$FF.BYTE  $FF,$00,$F8,$F8,$F8,$F8,$00,$FF.BYTE  $FF,$00,$FC,$FC,$FC,$FC,$00,$FF.BYTE  $FF,$00,$FE,$FE,$FE,$FE,$00,$FF.BYTE  $FF,$00,$FF,$FF,$FF,$FF,$00,$FF;;;;;;.END