; PUT "FLASH-COLOURS";; CALLED BY THE RASTER ONLY ON; THE TITLE PAGE SEQUENCE.;; (C) MEGA-CODER OF M.P.L;FLCOLS;JSR FLSTIT;; FLASH TITLE;JSR NICANI;; NICE TITLE ANIMATIONS;RTS;;**********************;;FLSTIT;LDA $0C32CMP #93BEQ DAFD;RTS ;* NOT IT TITLE YET;DAFD;INC FLST1LDA FLST1CMP #20BEQ TIM1;RTS;TIM1;LDA #0STA FLST1;LDX #19;FLG1;INC $0832,X;LDA $0832,X;TAY;AND #7BEQ FLG1;TYA;AND #%01110111;; NO FLASH OR MULTI-COLOUR;STA $0832,X;DEXBPL FLG1;RTS;;**********************;;;;.END