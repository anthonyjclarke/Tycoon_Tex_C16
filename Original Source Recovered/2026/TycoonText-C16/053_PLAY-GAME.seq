; PUT "PLAY-GAME";PLGAME;JSR MANOFF;SEI;; NOTE ALL VARIABLES ARE CLEARED; AT START OF EVERY GAME.;JSR CLVARS;LDA SELIVESTA LIVES;; NO. OF SELECTED LIVES;LDA #1STA NOLEFTSTA MVETEMSTA RDTMSTA SCRTEMSTA OTEMSTA STARCT;JSR CLSDIS;JSR SCREEN;LDA CHLIVS+$DSTA $C65   ;* ASCII;LDA #<$EA9 ;*STA ML     ;*  MAN INITIAL;          ;*LDA #>$EA9 ;*  SCREEN POSITIONSTA ML+1   ;*;JSR MANON;CLI;LDX #1STX STOPSTX TITLE;;STX CHEAT  ;* CHEAT ENABLE;DEXSTX LEVEL  ;* START LEVEL;DEXSTX AREA;JSR NEWLVL;; SET UP EVERYTHING;JSR PROILPJSR PRCOMP;JSR START ;* GLOP COUNT DOWN;LDA #0STA STOPSTA TITLE;LOOP;LDA PAUSEBNE LOOP;; THE IRQ WILL SET PAUSE IF; A STOP OF THE WHOLE PROGGY; IS REQUIRED.;LDA FINITOBNE OHNO;LDA ESCAPEBEQ NESC;JMP EXAPED  ;* ESCAPE GAME;NESC;LDX BASDLYJSR DELAY+2;DEC OTEM    ;* OIL TEMPOBNE FGP;LDA OILTIT  ;* OIL TEMPOSTA OTEM;LDA #1JSR PRESDO  ;* PRESSURE DOWN;FGP;JSR BASALI  ;* MOVE ALIENS;LDA WAKSPDBEQ NOSCOR  ;* NOT WALKING;DEC SCRTEMBNE NOSCOR;LDA #24STA SCRTEM;LDA #1JSR SCORE   ;* SCORE + 1;LDX WAKSPDLDA AMOUNT,X;JSR COMPUP  ;* % + 1;NOSCOR;LDA DONEBEQ LAZY;JSR LVLOVR;LAZY;LDA BLOOUTBEQ NOBLOW;JMP BUSTER ;* NO OIL LEFT;NOBLOW;JMP LOOP;OHNO;LDA DEMOBNE EXAPED;; CLEAR SCORE FIRST;SEI;LDX #1STX STOPSTX TITLE;DEXSTX PAUSE  ;* IN CASE PAUSE WAS ON;JSR ALLKIL ;* KILL ALL ALIENS;JSR CLSDIS;CLI;JSR BYE   ;* END BIT;LDX #5;GTSCRE;LDA $C56,XSTA SIKBUF,X;DEXBPL GTSCRE;; COPY SCORE;JMP GLOPPY;; GO TO TITLE PAGE STUFF;;*************************;AMOUNT;.BYTE 0,1,2,3,3,3,4,4;;*************************;EXAPED;; EXITED FROM GAME;SEI;LDX #5LDA #$30;TAC2;STA SCRPOS,XDEXBPL TAC2;; IF ESCAPED NO SCORE ALLOWD; OR IF DEMO THEN NO SCORE;LDX #0STX ESCAPESTX FIRESTX JUMPINSTX DEMO;INXSTX ONLYRD;JMP OHNO;.END