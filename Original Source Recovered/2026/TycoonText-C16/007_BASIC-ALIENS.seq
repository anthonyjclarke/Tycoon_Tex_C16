; PUT "BASIC-ALIENS";; CALLED BY THE NORMAL LOOP; TO UPDATE THE OTHER ALIENS.;; I.E. BOUNCING BALL;      SUICIDE PLANE;;;BASALI;LDA ALSTATAND #2BEQ TRYPL;JSR MBALL;TRYPL;LDA ALSTATAND #8BEQ TRYBOM;JSR MSUICI ;* MOVE SUICIDE THING;TRYBOM;;RTS;;***************************;ALLKIL;; KILLS ALL THE ALIENS;LDA #0STA ALSTATSTA PRBALLSTA ARRPRNSTA PRJETSTA PRBMSTA PRSUICSTA BALLONSTA ARRONSTA JETONSTA SUICONSTA BOMBD;STA RUBBAL;;RTS;;;;.END