; PUT "LANDSCAPE";;; TO PUT ON THE BOOOTIFULL HILLS;;NEWHIL;DEC XHIL    ;* COLUMN COUNTBPL FOPPY;JSR NDNEW   ;* START NEW HILL;FOPPY;LDA #$9F    ;* TOP RIGHT CORNERSTA LANL    ;* TO PUT ON NEW HILLLDA #$0CSTA LANL+1;LDX #4;HLLOP;LDY HILY,X;LDA HILCHRSTA (LANL),Y;INC HILCHR;DEXBPL HLLOP;RTS;;;NDNEW;; TIME TO START A NEW HILL LADS!;LDA RND+2AND #3PHA;JSR RANDOM;PLATAX;LDA RND,X;AND #7TAX;CPX LASHIL ;* SAME AS LAST ONE ?BEQ NDNEW  ;* GET ANOTHER;; ^ WILL STOP 2 HILLS THE SAME;STX LASHIL ;* THIS ONE'S #;LDA HILLST,XSTA HILCHR;; START CHAR OF HILL;LDA #7STA XHIL;; COLUMN COUNT;RTS;;;;.END