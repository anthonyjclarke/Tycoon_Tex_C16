; PUT "DIFFICULTY";; SET UP THE VARS FOR THE LEVEL; HELD IN VARIABLE 'LEVEL' WHICH; GOES FROM 1-99;SKILL1 = 176SKILL2 = 128SKILL3 = 64SKILL4 = 1;SKLTBL .BYTE 128,100,58,1;TIMDLY .BYTE 24,16,8;ARAB   .BYTE 24,19,14;NEWLVL;SED;LDA LEVELCLCADC #1STA LEVEL;CLD;LDX AREAINXCPX #3BNE NTLG;LDX #0;NTLG;STX AREA;; AREA GOES 0,1,2,0,1,2,0,1,2 ETC;LDA LEVELCMP #4BCS LRGCRT;; STILL IN EARLY LEVEL SO SMALL; CRATERS ONLY;LDA #SKILL1STA BSKILL;LDA #2BNE GROT;LRGCRT;LDA #3;GROT;STA MAXCRA;; THAT'S THE CRATER SIZE SET UP;;-------------------------------;; NOW LETS TAKKLE THE ALIENS;LDA LEVELCMP #1BNE NTLV1;LDA #%0000100 ;* JETSTA ALSTAT;BNE EXALN;NTLV1;CMP #2BNE NTLV2;LDA #%00000010 ;* BALLSTA ALSTAT;BNE EXALN;NTLV2;CMP #3BNE NTLV3;LDA #%00001000 ;* SUICIDESTA ALSTAT;BNE EXALN;NTLV3;; NOT IN LEVEL 1,2 OR 3;CMP #7BCS NTLV7;; IN LEVEL 4,5 OR 6;; SO CHOOSE 2 RANDOM ALIENS;GTNOT;SEI;JSR RANDOM;CLI;LDA RND+2;AND #7;CMP #6BCS GTNOT;; ACC = 0 - 5;TAXLDA LV4TO6,X;STA ALSTAT;LDA #SKILL2STA BSKILL;BNE EXALN;NTLV7;CMP #10BCS NTLV10;; IN LEVEL 7,8 OR 9;; SO CHOOSE 3 ALIENS;ANTH;SEI;JSR RANDOM;CLI;LDA RND+3;AND #3TAX;LDA LV7TO9,XSTA ALSTAT;LDA #SKILL3STA BSKILL;BNE EXALN;NTLV10;; MUST BE IN LEVEL 10 OR >; SO ALL 4 ALIENS ARE PRESENT;LDA #%00001111STA ALSTAT;LDA #SKILL4STA BSKILL;;-----------------------------;EXALN;; NOW LET'S DO THE JET CRATER ?;LDA LEVELCMP #7BCC BJH;LDA ALSTATORA #%00010000STA ALSTAT;BJH;;-------------------------------;;    NOW FREQUENCY OF ALIENS;LDA LEVEL;AND #$60;LSR ALSR ALSR ALSR ALSR A;; LEVEL / 32;TAXLDA SKLTBL,X;STA BALLFR;STA SUIFRQ;STA ARRFRQ;STA JETFRQ;LDX ABLE;LDA TIMDLY,X;STA BASDLY;; MAIN LOOP DELAY;LDA ARAB,XSTA OILTIT;; OIL PRESSURE TEMPO -NO.;JSR SETSHT ;* SET UP NEW COLS;LDA #1STA BORIS;; DONT REPRINT TOP BIT ON SCREEN;JSR SCREEN ;* INIT DISPLAY;DEC BORIS;JSR ALIGET ;* GET ALIENS;JSR SCRLND ;* NEW LAND ON;; SCROLLED ON SOME ROAD;LDA #25STA PRESHI;LDA #7STA PRESLO;; START PRESSURE AT MAXIMUM;LDA #0STA BLOOUT;STA COMPLOSTA COMPHI;STA DEMOD;LDA #12STA BALTEMSTA SUITEMSTA ARRTEMSTA JETTEM;RTS;;******************************;; HERE'S ANY TABLES;LV4TO6;.BYTE %00000011.BYTE %00000101.BYTE %00001001.BYTE %00000110.BYTE %00001010.BYTE %00001100;LV7TO9;.BYTE %00000111.BYTE %00001011.BYTE %00001101.BYTE %00001110;;;;;.END