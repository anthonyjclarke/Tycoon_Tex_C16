; PUT "PAUSER";CHKPAS;; CALLED UNDER IRQ TO CHECK; FOR PAUSE;LDA TITLEBEQ RNGME;GORF;RTS ;* IN TITLE PAGE;RNGME;LDA DEADBNE GORF;LDA #$10   ;* 'ESCAPE' TO ESCAPELDY #$BF   ;* FROM GAME;JSR KEYIT;BCC WALTER;LDX #1STX ESCAPE; STX STOP;; DEX; STX JUMPIN;RTS;WALTER;LDA PAUSEBNE PSEON  ;* ALREADY ON;LDA #$10LDY #$7F;JSR KEYIT  ;* SPACE PRESSED;BCS WAITRL;RTS ;* NOT PRESSED;WAITRL;LDA #1STA PAUSE;RTS;PSEON;LDA #$20LDY #$7F;JSR KEYIT  ;* CBM KEY TO UN-PAUSE;BCS STPPSE;RTS;STPPSE;LDA #0STA PAUSE;RTS;;.END