; PUT "DEMO-MEGA/CODE";; CALLED BY THE JOYDICK READER; IF WE ARE IN A DEMO.;DEMOON;LDX #4LDA #0;CLIT;STA JLEFT,XDEXBPL CLIT;LDA DEMODBNE INMIDD;LDA #$80STA JRIGHT;LDA MLCMP #$B8BEQ INMDOK;RTS;INMDOK;LDA #1STA DEMOD;INMIDD;LDA MLCMP #$B4;BCC GUUFER ;* CAN'T GO LEFT;LDA RND+1CMP #$20BCS GUUFER;LDA #$80STA JLEFTBMI GONADS;GUUFER;LDA RNDCMP #$E0BCC GONADS;; LET'S GO RIGHT - OK YAH!;LDA #$80STA JRIGHT;GONADS;; SHALL WE FIRE ?;LDA RND+3;CMP #$10BCS PISOFF;LDA #$80STA JFIRE;PISOFF;; SHALL WE JUMP ?;LDY #$CBLDA (ML),Y;CMP #221BCS NODMJP;CMP #214BCC NODMJP;LDA #$80STA JUP;NODMJP;RTS;;;;;;;.END