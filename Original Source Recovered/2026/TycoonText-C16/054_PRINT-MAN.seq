; PUT "PRINT-MAN";;;;MANON;LDA MLSTA MCL;LDA ML+1SECSBC #4STA MCL+1;JSR CHKLND ;* CHEK LAND;LDA #64STA CHRONLDX #0;MANL;LDY YVAL,X;LDA (ML),YCMP #92BCC ALIVE;LDA #1STA DEAD;ALIVE;LDA CHRONSTA (ML),Y;LDA MANCOLSTA (MCL),Y;INC CHRON;INXCPX #15BNE MANL;RTS;;************;;MANOFF;LDX #14LDA #32;MANO;LDY YVAL,XSTA (ML),Y;DEXBPL MANO;RTS;;*************;CHKLND;LDY #200;LDA (ML),Y;CMP #217BCC NTDD ;* OK;CMP #219 ;* LEFT CHAR OF R.H.BRKBEQ NTDD;CMP #221 ;* RIGHT CHAR OF R.H.BRKBEQ NTDD;CMP #234BCS NTDD ;* OK;LDA #1STA DEADSTA DISJUM;NTDD;RTS;;;.END