; PUT "ALTERABLES";;; MANIPULATE THE VARIABLES;; I.E. SOUND ON/OFF;      SELECT PLAY;      SELECT ABILITY;      ALTER NO. OF LIVES;ALTER;LDA NUMSEL;CMP #3BNE NTPLY;; HAS SELECTED PLAY GAME;LDA #1STA EXIT;JMP SONK;NTPLY;CMP #1BNE NTNLIV;; WANTS TO CHANGE NO. OF LIVES;INC SELIVELDA SELIVECMP #7BNE ANT1;LDA #1;ANT1;STA SELIVEORA #$30STA CHLIVS+$D;JMP SONK;NTNLIV;CMP #2BNE NTPLNT;LDA SOFLAGEOR #1STA SOFLAG;ASL A;ADC SOFLAG;; ACC X 3;TAX;LDY #0;PLN2;LDA SOUNTT,XSTA CHPLAN+9,Y;INXINYCPY #3BNE PLN2;JMP SONK;NTPLNT;; MUST HAVE SELECTED ABILITY;CMP #0BNE TRYDEM;LDY ABLEINYCPY #3BNE WHEN;LDY #0;WHEN;STY ABLE;LDX ABLOFS,Y;LDY #0;PILOK;LDA ABLTBL,X;BEQ SONK;STA STIFF+1,Y;INYINXBNE PILOK;JMP SONK;TRYDEM;; MUST WANT A DEMO;LDA #1STA DEMOSTA EXIT;SONK;RTS;;*************************;SOUNTT;.BYTE 'OFFON ';;ABLTBL;.BYTE '    EASY    ',0.BYTE '    HARD    ',0.BYTE 'IMPOSSIBLE !',0;ABLOFS .BYTE 0,13,26;;.END