; PUT "BREAK-IN-PIPE";; PUT A BREAK IN THE PIPE;BREAK;LDX #3LDY #217;BRAK1;TYASTA SCRBUF,X;DEYDEXBPL BRAK1;; LEFT BREAK IN;LDA RND+1AND #1STA BUFLEN;LDA MAXCRA ;* SIZE OF CRATERCMP #2BEQ OUTIY;LDA RND+3AND #1;CLCADC BUFLEN  ;* ACC = 0,1,2STA BUFLEN;; BUFLEN HOLDS SIZE OF GAP;; SIZE IS 1 ,2 OR 3 GAPS;OUTIY;LDA BUFLEN;TAX;BRAK2;TXAPHA;JSR RANDOM;PLATAX;LDA RND+1AND #1STA BUFPOI;LDA RND+2AND #1;CLCADC BUFPOI;; ACC = 0,1,2;ASL AASL A;; *4;ADC #222    ;* BASE CHAR;STA BUFC,X;DEXBPL BRAK2;; FILLS BUFC WITH THE START; NUMBERS OF THE CHARS;;LDY #4   ;* START OF BUFFERLDX #0;BRAK4;LDA BUFC,XSTA PLONK;TXAPHA;LDX #3;BRAK5;LDA PLONKSTA SCRBUF,Y;INC PLONKINY;DEXBPL BRAK5;PLATAX;INXDEC BUFLENBPL BRAK4;; ALL THE GAPS IN NOW JUST THE END;LDX #3;LDA #221STA PLONK;BRAK6;LDA PLONKSTA SCRBUF,Y;DEC PLONKINYDEXBPL BRAK6;LDA #0STA BUFPOI;STY BUFLEN;RTS;;****************;BUFC .BYTE 0,0,0,0 ;* MAX 4 WIDE;;****************;;-------------------------------; THIS ROUTINE WILL PUT A BREAK; IN THE PIPE ON THE SCREEN IF; POSSIBLE,;; AT TIME OF GOING TO PRESS IT; WILL ONLY BE USED BY THE; SUICIDE PLANE. !;PUTBRK;; X,Y HOLD ADDRESS OF '*';;      *###     *=T.L.;      ####;---------------- LAND;   A LLMMRR B  ; BREAK POSITION;     LLMMRR;; SO CHECK FROM A TO B FOR A; BREAK ALREADY THERE;STX BRKLSTY BRKL+1;LDX #9     ;* NO TO CHECK;LDY #75    ;* START AT A;METLOF   ;* HEEEAAAAVVVYYYY !;LDA (BRKL),YCMP #215       ;*BCC OKTP       ;*;              ;* PIPE BREAK CHARSCMP #234       ;*BCS OKTP       ;*;; SORRY THERE IS A PIPE ALREADY; THERE SO PISS OFF !;LDA #2JSR PRESDO;; PRESSURE DOWN A LITTLE;RTS;OKTP;; CHAR OK;INYDEX;BPL METLOF;; OK GO FOR IT BORIS HEAMAGLOBIN;LDX #0LDY #79;MEAT2;LDY HOLEYY,XLDA HOLECH,XSTA (BRKL),Y;INYINXCPX #12BNE MEAT2;LDA #4JSR PRESDO  ;* OIL PRESSURE DOWN;RTS;;==============;HOLECH;.BYTE 215,217,223,225,220,218.BYTE 214,216,222,224,221,219;;==============       ^^^ ^^^;                   FUNNY ORDERHOLEYY;.BYTE 79,80,81,82,83,84.BYTE 119,120,121,122,123,124;;;.END