; PUT "BUSTER";; COMES HERE WHEN THE OIL; PRESSURE HAS GOT TO ZERO.;; & AS DECIDED BY MUFF AND; MYSELF THIS WILL HAPPEN:-;; 1) PUT MAN IN THE CENTRE.;; 2) STOP EVERYTHING.;; 3) PRINT A MESSAGE.;; 4) WAIT A WHILE.;; 5) JUMP BACK TO THE NORMAL;    END SO AS TO DO THE 'THE;    END' SEQUENCE.;BUSTER;JSR SCRLND;; NEW LAND ON;SEI;LDA #1STA STOPSTA TITLE;LDA #0STA ALSTATSTA WAKSPDSTA HILSPDSTA GNDSPDSTA JUMPINSTA FIRE;JSR ALLKIL;JSR CLSDIS;LDA #<$0EBASTA ML;LDA #>$0EBASTA ML+1;JSR MANON;CLI;; NOW LETS PRINT THE MESSAGE;LDY #29LDA #'*;EK1;STA $D6D,YSTA $E5D,Y;DEYBPL EK1;LDX #5;EK2;LDY HILY,X;STA $D95,YSTA $D95+29,Y;DEXBPL EK2;LDA #<ENDMESSTA HISCL;LDA #>ENDMESSTA HISCL+1;LDA #<$D96STA SL;LDA #>$D66STA SL+1;LDX #4;EAK1;LDY #0;EAK2;LDA (HISCL),YAND #$3FSTA (SL),Y;TYAPHA;TXAPHA;LDX #$20JSR DELAY+2;PLATAX;PLATAY;INYCPY #28BNE EAK2;LDA HISCLCLCADC #28STA HISCL;LDA HISCL+1ADC #0STA HISCL+1;LDA SLCLCADC #40STA SL;LDA SL+1ADC #0STA SL+1;DEXBPL EAK1;LDA #10STA ROLL;EAK;LDX #$00JSR DELAY+2;DEC ROLLBNE EAK;JMP OHNO;;;;;.END