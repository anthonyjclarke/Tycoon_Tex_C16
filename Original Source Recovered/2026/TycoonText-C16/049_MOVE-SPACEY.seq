; PUT "MOVE-SPACEY";;;;MVESPC;LDA PAUSEBEQ TRUMP;RTS ;* PAUSE ON;TRUMP;LDA STOPBEQ YUKKY;JMP NELLY;; IF STOP=1 (STOP MOVEMENT) THEN; JUST FINISH JUMPER;YUKKY;LDA #0STA MVELR;LDA JUMPINBNE NLEFT;; DONT ALLOW X MOVEMENT IF IN AIR;BIT JRIGHTBPL NRIGHT;JSR MOVET;BCC NRIGHT;LDA NORIGTBNE NRIGHT;LDA MLCMP #$C3BEQ NRIGHT;LDA #1STA MVELR;JSR MANOFF;DPINC ML;LDA #0STA NOLEFT;JSR SETVAR;NRIGHT;BIT JLEFTBPL NLEFT;JSR MOVET;BCC NLEFT;LDA NOLEFT    ;* AT EXTREME LEFTBNE NLEFT;LDA MLCMP #$A9BEQ NLEFT;LDA #1STA MVELR;JSR MANOFF;DPDEC ML;LDA #0STA NORIGT;JSR SETVAR;NLEFT;LDA MVELRBNE NUP;; THIS WILL STOP YOU JUMPING; AND MOVING LEFT AND RIGHT;BIT JUPBPL NUP;JSR JUMPER    ; ALL JUMP STUFF;NUP;; BIT JDOWN; BPL NDWN;; LDA #1; STA BLOOUT;NDWN;BIT JFIREBPL NFIRE;LDA FIREBNE NFIRE     ;* ALREADY FIRING;JSR NEWFIR;NFIRE;JSR MANON;NELLY;JSR UPJUMP;;RTS;;;;;****************;MOVET;; MOVEMENT TEMPO;DEC MVETEMBNE TROUT;LDA #3STA MVETEM;SEC;RTS;TROUT;CLC;RTS;;****************;SETVAR;; SET MOVEMENT VARIABLES;LDX #7LDA ML;CPLOOP;CMP COMPAR,XBEQ FORIT;DEXBPL CPLOOPBMI NOIT;FORIT;STX WAKSPD;LDA LANDSP,XSTA GNDSPD;LDA HILLSP,XSTA HILSPD;LDA ANIMSP,XSTA ANISPD;LDA #1STA ANITEM;NOIT;RTS;;*********************;COMPAR;.BYTE $A9,$AC,$AF,$B2.BYTE $B5,$B8,$BB,$BE;;;*********************;LANDSP;.BYTE 0,2,3,4,5,6,7,7;;*********************;HILLSP;.BYTE 0,1,1,1,2,2,2,3;;*********************;ANIMSP;.BYTE 00,$16,$10,$0E,10,7,3,1;;*********************;;;;;.END