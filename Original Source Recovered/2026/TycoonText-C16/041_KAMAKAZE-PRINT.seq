; PUT "KAMAKAZE-PRINT";KAMAZ;LDA RUBSUIBEQ KAMA1;LDX #5LDA #32;KAMA2;LDY KAMY,X    ;* SAME Y VALSSTA (RSUIL),Y;DEXBPL KAMA2;LDA #0STA RUBSUI    ;* DONE IT;KAMA1;LDA PRSUICBNE KAMA3;RTS;KAMA3;LDA PSUILSTA CSUIL;LDA PSUIL+1SECSBC #4STA CSUIL+1;LDX #5LDA #122STA CHRON;KAMA4;LDY KAMY,XLDA CHRONSTA (PSUIL),Y;LDA SUICOLSTA (CSUIL),Y;DEC CHRONDEXBPL KAMA4;RTS;;KAMY .BYTE 0,1,2,40,41,42;;;;.END