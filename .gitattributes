# Preserve historical input bytes, including the 1992 CRLF text exports.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
Makefile text eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.prg binary
*.BIN binary
*.PRG binary
*.d64 binary

# These override generic rules for every preserved input.
"/Original Source Recovered/**" -text -whitespace
"/Original Artifacts/**" -text -whitespace
